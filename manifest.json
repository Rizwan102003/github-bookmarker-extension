{
    "manifest_version": 3,
    "name": "GitHub Private Bookmarker",
    "version": "1.0",
    "description": "Privately bookmark GitHub repos without starring them.",
    "permissions": ["storage", "tabs", "scripting"],
    "action": {
      "default_popup": "popup.html",
      "default_icon": "icons/icon128.png"
    },
    "host_permissions": [
      "https://github.com/*"
    ],
  "options_page": "bookmarks.html",
  "icons": {
    "128": "icons/icon128.png"
  }
}